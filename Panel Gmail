<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:layoutsVersion='3' b:responsive='true' b:templateVersion='1.3.0' expr:dir='data:blog.languageDirection' lang='en' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title>Unlimited Email Creation Panel &#8212; Legal Providers Only</title>
  <script src='https://cdn.tailwindcss.com'/>
  <meta content='A single-file web panel to generate unlimited emails using legal temporary email providers (Mail.tm, 1secMail) and export results. No Google or phone verification bypass.' name='description'/>
  
  <b:skin><![CDATA[
    /* Scrollbar cosmetics */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 9999px; }
    ::-webkit-scrollbar-track { background: #f3f4f6; }
  ]]></b:skin>
</head>

<body class='bg-slate-50 text-slate-800'>

  <div class='max-w-6xl mx-auto p-4 sm:p-6'>
    <header class='flex items-center justify-between mb-6'>
      <div>
        <h1 class='text-2xl sm:text-3xl font-bold'>Unlimited Email Creation Panel</h1>
        <p class='text-sm text-slate-500'>Mail.tm &#8226; 1secMail &#8226; Custom Pattern &#8226; Export CSV/JSON/TXT</p>
      </div>
      <div class='flex items-center gap-3'>
        <button class='px-3 py-2 rounded-2xl bg-red-50 hover:bg-red-100 text-red-600 text-sm shadow' id='btnClearAll'>Clear All</button>
        <a class='px-3 py-2 rounded-2xl bg-slate-900 hover:bg-black text-white text-sm shadow cursor-pointer' id='btnDownloadBackup'>Backup Data</a>
      </div>
    </header>

    <nav class='grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6'>
      <button class='tab-btn px-4 py-3 rounded-2xl bg-white shadow text-sm font-medium' data-tab='tab-login'>Admin Login</button>
      <button class='tab-btn px-4 py-3 rounded-2xl bg-white shadow text-sm font-medium' data-tab='tab-single'>Single Create</button>
      <button class='tab-btn px-4 py-3 rounded-2xl bg-white shadow text-sm font-medium' data-tab='tab-bulk'>Bulk Create</button>
      <button class='tab-btn px-4 py-3 rounded-2xl bg-white shadow text-sm font-medium' data-tab='tab-settings'>Providers &amp; Export</button>
    </nav>

    <section class='tab-card hidden' id='tab-login'>
      <div class='bg-white rounded-2xl shadow p-5'>
        <h2 class='font-semibold text-lg mb-3'>Admin Access</h2>
        <p class='text-sm text-slate-500 mb-4'>Set a local password to protect your data on this device. (Client-side only)</p>
        <div class='grid sm:grid-cols-2 gap-4'>
          <div>
            <label class='text-sm'>New Password</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border outline-none' id='newPwd' placeholder='••••••••' type='password'/>
          </div>
          <div class='flex items-end'>
            <button class='w-full sm:w-auto px-4 py-2 rounded-xl bg-slate-900 text-white shadow' id='btnSetPwd'>Set / Update</button>
          </div>
          <div>
            <label class='text-sm'>Login Password</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border outline-none' id='loginPwd' placeholder='••••••••' type='password'/>
          </div>
          <div class='flex items-end'>
            <button class='w-full sm:w-auto px-4 py-2 rounded-xl bg-emerald-600 text-white shadow' id='btnLogin'>Unlock</button>
          </div>
        </div>
        <p class='mt-3 text-sm' id='authMsg'/>
      </div>
    </section>

    <section class='tab-card hidden' id='tab-single'>
      <div class='bg-white rounded-2xl shadow p-5'>
        <h2 class='font-semibold text-lg mb-3'>Single Email Creation</h2>
        <div class='grid sm:grid-cols-4 gap-4'>
          <div class='sm:col-span-2'>
            <label class='text-sm'>Provider</label>
            <select class='mt-1 w-full px-3 py-2 rounded-xl border outline-none' id='singleProvider'>
              <option value='mailtm'>Mail.tm (account)</option>
              <option value='1sec'>1secMail (random mailbox)</option>
              <option value='custom'>Custom Pattern (local only)</option>
            </select>
          </div>
          <div class='sm:col-span-2'>
            <label class='text-sm'>Username seed (optional)</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='singleSeed' placeholder='e.g. shahid'/>
          </div>
          <div class='sm:col-span-2'>
            <label class='text-sm'>Password (for Mail.tm)</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='singlePwd' placeholder='auto-generated if empty' type='text'/>
          </div>
          <div class='sm:col-span-2 flex items-end'>
            <button class='w-full sm:w-auto px-4 py-2 rounded-xl bg-slate-900 text-white shadow' id='btnSingleCreate'>Create</button>
          </div>
        </div>
        <div class='mt-4 text-sm' id='singleResult'/>
      </div>
    </section>

    <section class='tab-card hidden' id='tab-bulk'>
      <div class='bg-white rounded-2xl shadow p-5'>
        <h2 class='font-semibold text-lg mb-3'>Bulk Email Creation</h2>
        <div class='grid sm:grid-cols-4 gap-4'>
          <div>
            <label class='text-sm'>Provider</label>
            <select class='mt-1 w-full px-3 py-2 rounded-xl border outline-none' id='bulkProvider'>
              <option value='mailtm'>Mail.tm</option>
              <option value='1sec'>1secMail</option>
              <option value='custom'>Custom Pattern</option>
            </select>
          </div>
          <div>
            <label class='text-sm'>Quantity</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='bulkQty' max='500' min='1' type='number' value='25'/>
          </div>
          <div>
            <label class='text-sm'>Seed / Prefix</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='bulkSeed' placeholder='brand, project, etc'/>
          </div>
          <div>
            <label class='text-sm'>Password (Mail.tm)</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='bulkPwd' placeholder='leave blank = auto'/>
          </div>
          <div class='sm:col-span-4 flex items-center gap-3'>
            <button class='px-4 py-2 rounded-xl bg-slate-900 text-white shadow' id='btnBulkStart'>Start</button>
            <button class='px-4 py-2 rounded-xl bg-red-50 text-red-600 shadow' id='btnBulkStop'>Stop</button>
            <div class='text-sm text-slate-500' id='bulkProgress'/>
          </div>
        </div>
        <div class='mt-4'>
          <h3 class='font-medium mb-2'>Live Log</h3>
          <div class='h-48 overflow-auto bg-slate-50 rounded-xl border p-3 text-xs' id='bulkLog'/>
        </div>
      </div>
    </section>

    <section class='tab-card hidden' id='tab-settings'>
      <div class='bg-white rounded-2xl shadow p-5'>
        <h2 class='font-semibold text-lg mb-3'>Providers &amp; Export</h2>
        <p class='text-sm text-slate-600 mb-4'>Add custom domain for local pattern, export your emails, or import backup.</p>
        <div class='grid sm:grid-cols-2 gap-4'>
          <div class='bg-slate-50 rounded-xl p-4 border'>
            <h3 class='font-medium mb-2'>Custom Pattern</h3>
            <label class='text-sm'>Domain</label>
            <input class='mt-1 w-full px-3 py-2 rounded-xl border' id='customDomain' placeholder='example.com'/>
            <p class='text-xs text-slate-500 mt-2'>Result pattern: <code>prefix+random@domain</code></p>
          </div>
          <div class='bg-slate-50 rounded-xl p-4 border'>
            <h3 class='font-medium mb-2'>Export</h3>
            <div class='flex flex-wrap gap-2'>
              <button class='px-3 py-2 rounded-xl bg-slate-900 text-white text-sm' id='btnExportCSV'>Export CSV</button>
              <button class='px-3 py-2 rounded-xl bg-slate-900 text-white text-sm' id='btnExportJSON'>Export JSON</button>
              <button class='px-3 py-2 rounded-xl bg-slate-900 text-white text-sm' id='btnExportTXT'>Export TXT</button>
              <label class='inline-flex items-center gap-2 text-sm cursor-pointer'>
                <input accept='application/json,text/plain' class='hidden' id='importFile' type='file'/>
                <span class='px-3 py-2 rounded-xl bg-white border shadow'>Import Backup</span>
              </label>
            </div>
          </div>
        </div>

        <div class='mt-6'>
          <h3 class='font-medium mb-2'>Saved Emails</h3>
          <div class='overflow-auto rounded-xl border'>
            <table class='min-w-full text-sm'>
              <thead class='bg-slate-100'>
                <tr>
                  <th class='text-left p-2'>#</th>
                  <th class='text-left p-2'>Email</th>
                  <th class='text-left p-2'>Provider</th>
                  <th class='text-left p-2'>Password</th>
                  <th class='text-left p-2'>Created</th>
                </tr>
              </thead>
              <tbody id='savedTable'/>
            </table>
          </div>
        </div>
      </div>
    </section>

    <footer class='mt-8 text-center text-xs text-slate-500'>
      Built for learning &amp; QA/testing. Respect provider ToS. No Google services are accessed by this tool.
    </footer>
  </div>

<script>
//<![CDATA[
    // ------------------------------
    // Utilities
    // ------------------------------
    const $ = (sel) => document.querySelector(sel);
    const $all = (sel) => Array.from(document.querySelectorAll(sel));

    const store = {
      get emails(){
        try { return JSON.parse(localStorage.getItem('emails')||'[]'); } catch { return []; }
      },
      set emails(list){ localStorage.setItem('emails', JSON.stringify(list)); renderSaved(); },
      get domain(){ return localStorage.getItem('customDomain') || 'example.com'; },
      set domain(v){ localStorage.setItem('customDomain', v); },
      get pwdHash(){ return localStorage.getItem('pwdHash') || ''; },
      set pwdHash(v){ localStorage.setItem('pwdHash', v); },
      get unlocked(){ return sessionStorage.getItem('unlocked') === '1'; },
      set unlocked(v){ sessionStorage.setItem('unlocked', v ? '1':'0'); },
    };

    function sha1(str){ // light client-side hash (not for real security)
      const encoder = new TextEncoder();
      const data = encoder.encode(str);
      return crypto.subtle.digest('SHA-1', data).then(buf => {
        return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
      });
    }

    function genRand(n=6){
      const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
      let out = '';
      for(let i=0;i<n;i++) out += chars[Math.floor(Math.random()*chars.length)];
      return out;
    }

    function download(filename, text){
      const blob = new Blob([text], {type: 'text/plain'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(()=>URL.revokeObjectURL(url), 5000);
    }

    function log(el, msg){
      const time = new Date().toLocaleTimeString();
      el.innerHTML += `<div><span class="text-slate-400">[${time}]</span> ${msg}</div>`;
      el.scrollTop = el.scrollHeight;
    }

    // ------------------------------
    // Auth (local only)
    // ------------------------------
    async function setPassword(){
      const v = $('#newPwd').value.trim();
      if(!v) return msg('#authMsg','Enter a password.', true);
      store.pwdHash = await sha1(v);
      msg('#authMsg','Password set/updated.');
    }

    async function login(){
      if(!store.pwdHash){ msg('#authMsg','Set a password first.', true); return; }
      const v = $('#loginPwd').value.trim();
      const h = await sha1(v);
      if(h === store.pwdHash){ store.unlocked = true; msg('#authMsg','Unlocked. You can use all tabs.'); } else { msg('#authMsg','Wrong password.', true); }
    }

    function msg(sel, text, error=false){
      const el = $(sel);
      el.textContent = text;
      el.className = 'mt-3 text-sm ' + (error? 'text-red-600':'text-emerald-600');
    }

    // ------------------------------
    // Tabs
    // ------------------------------
    function showTab(id){
      if(!store.unlocked && id !== 'tab-login'){ id = 'tab-login'; }
      $all('.tab-card').forEach(c=>c.classList.add('hidden'));
      $('#'+id).classList.remove('hidden');
      $all('.tab-btn').forEach(b=> b.classList.toggle('bg-slate-900', b.dataset.tab===id));
      $all('.tab-btn').forEach(b=> b.classList.toggle('text-white', b.dataset.tab===id));
    }

    // ------------------------------
    // Providers
    // ------------------------------
    async function createMailTmAccount(seed, pwd){
      const username = (seed||'user')+"_"+genRand(6);
      const email = username + '@' + (await pickMailTmDomain());
      const password = pwd || 'P@ss' + genRand(8);

      const res = await fetch('https://api.mail.tm/accounts', {
        method: 'POST', headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ address: email, password })
      });
      if(res.status === 201){
        return { email, password, provider: 'mail.tm' };
      } else {
        const username2 = (seed||'user')+"_"+genRand(8);
        const email2 = username2 + '@' + (await pickMailTmDomain());
        const res2 = await fetch('https://api.mail.tm/accounts', {
          method: 'POST', headers: { 'Content-Type':'application/json' },
          body: JSON.stringify({ address: email2, password })
        });
        if(res2.status === 201){ return { email: email2, password, provider:'mail.tm' }; }
        const errText = await res.text().catch(()=> '');
        throw new Error('Mail.tm failed: ' + res.status + ' ' + errText);
      }
    }

    async function pickMailTmDomain(){
      const res = await fetch('https://api.mail.tm/domains?page=1');
      const js = await res.json();
      if(js['hydra:member'] && js['hydra:member'].length){
        const d = js['hydra:member'][Math.floor(Math.random()*js['hydra:member'].length)].domain;
        return d;
      }
      return 'mail.tm';
    }

    async function create1SecMail(seed){
      const count = 1;
      const res = await fetch('https://www.1secmail.com/api/v1/?action=genRandomMailbox&count=' + count);
      const list = await res.json();
      const email = list[0];
      const emailParts = email.split('@');
      const local = (seed? (seed+"+") : '') + emailParts[0];
      return { email: local + '@' + emailParts[1], password: '', provider: '1secMail' };
    }

    function createCustom(seed){
      const dom = $('#customDomain').value.trim() || store.domain;
      const email = (seed || 'user') + '+' + genRand(8) + '@' + dom;
      return { email, password: '', provider: 'custom' };
    }

    function saveEmail(obj){
      const list = store.emails;
      list.push({ ...obj, created: new Date().toISOString() });
      store.emails = list;
    }

    // ------------------------------
    // Single Create
    // ------------------------------
    async function singleCreate(){
      const provider = $('#singleProvider').value;
      const seed = $('#singleSeed').value.trim();
      const pwd = $('#singlePwd').value.trim();
      $('#singleResult').innerHTML = 'Working…';
      try {
        let out;
        if(provider==='mailtm') out = await createMailTmAccount(seed, pwd);
        else if(provider==='1sec') out = await create1SecMail(seed);
        else out = createCustom(seed);
        saveEmail(out);
        $('#singleResult').innerHTML = `<div class="p-3 bg-emerald-50 border rounded-xl">
            <div><b>Email:</b> ${out.email}</div>
            <div><b>Provider:</b> ${out.provider}</div>
            <div><b>Password:</b> ${out.password || '<i>(none)</i>'}</div>
            </div>`;
      } catch (e){
        $('#singleResult').innerHTML = `<div class="p-3 bg-red-50 border rounded-xl text-red-700">${e.message}</div>`;
      }
    }

    // ------------------------------
    // Bulk Create
    // ------------------------------
    let bulkAbort = false;
    async function bulkStart(){
      bulkAbort = false;
      const provider = $('#bulkProvider').value;
      const qty = Math.max(1, Math.min(500, parseInt($('#bulkQty').value||'1',10)));
      const seed = $('#bulkSeed').value.trim();
      const pwd = $('#bulkPwd').value.trim();
      const logEl = $('#bulkLog');
      logEl.innerHTML = '';
      $('#bulkProgress').textContent = `0 / ${qty}`;

      for(let i=1;i<=qty;i++){
        if(bulkAbort){ log(logEl, 'Stopped by user.'); break; }
        try{
          let out;
          if(provider==='mailtm') out = await createMailTmAccount(seed, pwd);
          else if(provider==='1sec') out = await create1SecMail(seed);
          else out = createCustom(seed);
          saveEmail(out);
          log(logEl, `✔️ ${i}. ${out.email} (${out.provider})`);
        } catch(e){
          log(logEl, `❌ ${i}. ${e.message}`);
        }
        $('#bulkProgress').textContent = `${i} / ${qty}`;
        await new Promise(r=>setTimeout(r, 250)); // tiny delay to be gentle
      }
    }

    function bulkStop(){ bulkAbort = true; }

    // ------------------------------
    // Export
    // ------------------------------
    function toCSV(rows){
      const header = ['email','provider','password','created'];
      const esc = (v) => '"' + String(v).replaceAll('"','""') + '"';
      const body = rows.map(r => header.map(k => esc(r[k]||'')).join(','));
      return header.join(',') + '\n' + body.join('\n');
    }

    function exportCSV(){
      download('emails.csv', toCSV(store.emails));
    }
    function exportJSON(){
      download('emails.json', JSON.stringify(store.emails, null, 2));
    }
    function exportTXT(){
      const lines = store.emails.map(r => `${r.email}\t${r.password||''}\t${r.provider}\t${r.created}`);
      download('emails.txt', lines.join('\n'));
    }

    function renderSaved(){
      const tbody = $('#savedTable');
      const rows = store.emails.map((r,i)=>`<tr class="odd:bg-white even:bg-slate-50">
          <td class="p-2">${i+1}</td>
          <td class="p-2 font-mono">${r.email}</td>
          <td class="p-2">${r.provider}</td>
          <td class="p-2 font-mono">${r.password||''}</td>
          <td class="p-2">${new Date(r.created).toLocaleString()}</td>
          </tr>`).join('');
      tbody.innerHTML = rows || `<tr><td colspan="5" class="p-3 text-center text-slate-400">No emails yet.</td></tr>`;
    }

    function backupAll(){
      const payload = {
        version: 1,
        when: new Date().toISOString(),
        domain: store.domain,
        emails: store.emails,
      };
      download('panel-backup.json', JSON.stringify(payload, null, 2));
    }

    function importBackup(file){
      const reader = new FileReader();
      reader.onload = () => {
        try{
          const obj = JSON.parse(reader.result);
          if(obj.domain) store.domain = obj.domain;
          if(Array.isArray(obj.emails)) store.emails = obj.emails;
          alert('Imported successfully.');
        }catch(e){ alert('Invalid file.'); }
      };
      reader.readAsText(file);
    }

    function clearAll(){
      if(confirm('Clear all saved emails and settings on this device?')){
        localStorage.removeItem('emails');
        localStorage.removeItem('customDomain');
        renderSaved();
        alert('Cleared.');
      }
    }

    // ------------------------------
    // Events
    // ------------------------------
    document.addEventListener('DOMContentLoaded', ()=>{
      $('#customDomain').value = store.domain;
      $all('.tab-btn').forEach(btn=> btn.addEventListener('click', ()=> showTab(btn.dataset.tab)));
      showTab('tab-login');
      $('#btnSetPwd').addEventListener('click', setPassword);
      $('#btnLogin').addEventListener('click', login);
      $('#btnSingleCreate').addEventListener('click', singleCreate);
      $('#btnBulkStart').addEventListener('click', bulkStart);
      $('#btnBulkStop').addEventListener('click', bulkStop);
      $('#btnExportCSV').addEventListener('click', exportCSV);
      $('#btnExportJSON').addEventListener('click', exportJSON);
      $('#btnExportTXT').addEventListener('click', exportTXT);
      $('#btnDownloadBackup').addEventListener('click', backupAll);
      $('#importFile').addEventListener('change', (e)=> e.target.files[0] && importBackup(e.target.files[0]));
      $('#customDomain').addEventListener('input', (e)=> store.domain = e.target.value.trim());
      $('#btnClearAll').addEventListener('click', clearAll);
      renderSaved();
    });
//]]>
</script>

  <b:section class='main' id='main-section' showaddelement='no'/>

</body>
</html>
